# ── JobHunt AI Studio Environment Blueprint ──
# Note: You can also enter API keys directly in the Web Dashboard sidebar per session!

# Google Gemini (Supports comma-separated keys for automatic 15 RPM rotation and failover)
GEMINI_API_KEYS=AIzaSyA_YourKey1,AIzaSyB_YourKey2,AIzaSyC_YourKey3
GEMINI_API_KEY=AIzaSyA_YourSingleKey

# DeepSeek (Optional paid high-speed provider)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI (Optional)
OPENAI_API_KEY=sk-your-openai-api-key
