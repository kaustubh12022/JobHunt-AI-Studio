# JobHunt AI Studio - private deployment blueprint.
# Copy to `.env` for local use. Never commit `.env`.

# The single DeepSeek key used for scoring, drafting and review.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Owner passphrase that unlocks the private studio (minimum 12 characters).
# Generate one with: python -c "import secrets; print('jh-'+secrets.token_urlsafe(24))"
STUDIO_ACCESS_KEY=choose-a-long-random-owner-passphrase

# Optional: only needed if you want the batch estimate to show USD pricing.
# DEEPSEEK_INPUT_PER_M=0.00
# DEEPSEEK_OUTPUT_PER_M=0.00
